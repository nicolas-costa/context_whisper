{
  "name": "context-whisper",
  "version": "1.4.0",
  "description": "MCP Server for vectorized technical notes repository with multi-database support (SQLite, PostgreSQL, MySQL + Qdrant)",
  "main": "dist/index.js",
  "repository": "https://github.com/nicolas-costa/context_whisper.git",
  "bin": {
    "context-whisper": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r src/web/public dist/web/ && chmod +x dist/web/standalone.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "sqlite",
    "postgresql",
    "mysql",
    "qdrant",
    "pgvector",
    "vector",
    "embeddings",
    "notes",
    "rag"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.6.0",
    "commander": "^12.1.0",
    "fastify": "^5.6.2",
    "marked": "^17.0.1",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
