{
  "name": "context-whisper",
  "version": "1.4.0",
  "description": "MCP Server for vectorized technical notes repository with multi-database support (SQLite, PostgreSQL, MySQL + Qdrant)",
  "main": "dist/index.js",
  "repository": "https://github.com/nicolas-costa/context_whisper.git",
  "bin": {
    "context-whisper": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/**",
    "sql/**",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc && cp -r src/web/public dist/web/ && chmod +x dist/web/standalone.js",
    "prepack": "npm run build",
    "test": "npm run build && node test-health.mjs && node test-multi-env.mjs && node test-multi-db-failures.mjs",
    "release:dry": "npm run test && npm pack",
    "release": "npm run test && npm publish",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "keywords": [
    "mcp",
    "sqlite",
    "postgresql",
    "mysql",
    "qdrant",
    "pgvector",
    "vector",
    "embeddings",
    "notes",
    "rag"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^11.6.0",
    "commander": "^12.1.0",
    "fastify": "^5.6.2",
    "marked": "^17.0.1",
    "mysql2": "^3.11.5",
    "pg": "^8.13.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.53.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
